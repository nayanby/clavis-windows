{
  "manifest_version": 3,
  "name": "Pearls Chat to Word",
  "version": "1.0.0",
  "description": "Export a ChatGPT, Claude or Gemini conversation or response as an editable Word file in your Clinical Notes template.",
  "permissions": ["activeTab", "scripting", "downloads"],
  "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*"],
  "action": { "default_title": "Show Word download toolbar" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*"],
    "js": ["capture.js", "page-toolbar.js"],
    "run_at": "document_idle"
  }],
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" }
}
